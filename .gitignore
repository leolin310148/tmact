.cache/
.tmact/
.agent-inbox/
tmact.agents.yaml
agents.yaml
bin/

# Machine-specific agent skills. These may contain local hostnames, paths, and
# deployment policy and must never be committed.
.agents/skills/local-*
.claude/skills/local-*
.codex/skills/local-*
.claude/settings.local.json

# Web UI build output — generated by `make web` (Vite), NOT committed.
# The .gitkeep keeps the directory present so go:embed compiles on a fresh
# clone before the frontend is built.
internal/web/static/*
!internal/web/static/.gitkeep
internal/web/frontend/node_modules/
# npx run from the repo root drops a node_modules/.vite cache here. Untracked
# files count as modified for Go's vcs stamp, so leaving it unignored brands
# every build "-dirty" and makes an installed binary look unversioned.
/node_modules/
# `go build ./cmd/tmact` without -o drops the binary here, which brands every
# later build "-dirty" for the same reason. Anchored so it cannot match the
# cmd/tmact package directory.
/tmact
